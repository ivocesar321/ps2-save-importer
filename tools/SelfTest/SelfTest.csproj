<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes automatizados do PS2 Save Importer (ferramenta de desenvolvimento, não faz parte do aplicativo entregue).
    Compila os mesmos fontes do app e exercita: validação de cartões, lista de destinos, pipeline de importação/backup
    (com cartões sintéticos e cópias, nunca os originais) e capturas de tela da interface.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>Ps2SaveImporter.SelfTest</AssemblyName>
    <RootNamespace>SelfTest</RootNamespace>
    <Version>2.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\App\Core\*.cs" />
    <Compile Include="..\..\App\UI\*.cs" />
    <Compile Include="..\..\App\Views\*.cs" />
    <EmbeddedResource Include="..\..\App\Assets\AppIcon.ico" LogicalName="AppIcon.ico" />
  </ItemGroup>

</Project>
